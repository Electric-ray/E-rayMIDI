<?xml version="1.0" encoding="utf-8"?>
<!-- 연결/정지 토글용 큼직한 물리 버튼 (파란 계열, 눌림 상태 포함) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0a2440" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#2a5a8a" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#26262a" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#3a3a3e" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#1a5a9a"
                android:endColor="#0f3460"
                android:type="linear" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#3a7aca" />
        </shape>
    </item>
</selector>
