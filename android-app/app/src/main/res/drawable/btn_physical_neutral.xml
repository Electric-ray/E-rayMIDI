<?xml version="1.0" encoding="utf-8"?>
<!-- 중립(회색) 물리 버튼 - ROM 안내 / 사운드폰트 선택 등 보조 버튼용 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#141416" />
            <corners android:radius="5dp" />
            <stroke android:width="1dp" android:color="#4a4a52" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#3a3a42"
                android:endColor="#242428"
                android:type="linear" />
            <corners android:radius="5dp" />
            <stroke android:width="1dp" android:color="#54545c" />
        </shape>
    </item>
</selector>
