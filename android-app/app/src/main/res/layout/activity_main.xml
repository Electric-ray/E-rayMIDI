<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_rack_panel"
    android:padding="8dp">

    <!-- ================= 타이틀 바 ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="E-rayMIDI v1.3"
            android:textColor="#e0e0ff"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="전기가오리\n네이버 도스박물관"
            android:textColor="#77778a"
            android:textSize="10sp"
            android:gravity="end"
            android:lineSpacingExtra="1dp"/>
    </LinearLayout>

    <!-- ================= 본체 3열 ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

    <!-- 왼쪽: MODE (재생 엔진 선택) -->
    <LinearLayout
        android:layout_width="98dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_module"
        android:padding="6dp"
        android:layout_marginEnd="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MODE"
            android:textColor="#8888aa"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:gravity="center"
            android:paddingBottom="6dp"/>

        <RadioGroup
            android:id="@+id/rgEngine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbEngineSc55"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="5dp"
                android:checked="true"
                android:text="SC-55"
                android:textSize="11sp"
                android:textColor="#e0e0ff"
                android:button="@null"
                android:drawableStart="@drawable/dot_led_selector"
                android:drawablePadding="6dp"
                android:paddingStart="8dp"
                android:gravity="center_vertical"
                android:background="@drawable/btn_led_toggle_bg"/>

            <RadioButton
                android:id="@+id/rbEngineSoundfont"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="5dp"
                android:text="SoundFont"
                android:textSize="11sp"
                android:textColor="#e0e0ff"
                android:button="@null"
                android:drawableStart="@drawable/dot_led_selector"
                android:drawablePadding="6dp"
                android:paddingStart="8dp"
                android:gravity="center_vertical"
                android:background="@drawable/btn_led_toggle_bg"/>

            <RadioButton
                android:id="@+id/rbEngineMunt"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="5dp"
                android:text="MT-32"
                android:textSize="11sp"
                android:textColor="#e0e0ff"
                android:button="@null"
                android:drawableStart="@drawable/dot_led_selector"
                android:drawablePadding="6dp"
                android:paddingStart="8dp"
                android:gravity="center_vertical"
                android:background="@drawable/btn_led_toggle_bg"/>

            <RadioButton
                android:id="@+id/rbEngineSyxg50"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="S-YXG50"
                android:textSize="11sp"
                android:textColor="#e0e0ff"
                android:button="@null"
                android:drawableStart="@drawable/dot_led_selector"
                android:drawablePadding="6dp"
                android:paddingStart="8dp"
                android:gravity="center_vertical"
                android:background="@drawable/btn_led_toggle_bg"/>
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>

    <!-- 가운데: 화면 + 상태 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 화면 스택: SC-55는 LCD, MT-32/SoundFont/S-YXG50은 LED 패널.
             동시에 하나만 visible이라 FrameLayout으로 겹쳐서 공간을 공유한다. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_lcd_bezel"
            android:padding="5dp">

            <FrameLayout
                android:id="@+id/lcdFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.example.nukedsc55.LcdView
                    android:id="@+id/ivLcd"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/llMuntPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"/>
            </ScrollView>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/llSoundfontPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"/>
            </ScrollView>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/llSyxg50Panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"/>
            </ScrollView>
        </FrameLayout>

        <!-- 상태 로그 + ROM 상태: 좌우 배치 (표시 정보량에 비해 세로로 쌓으면 폭이 너무 넓었음) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <ScrollView
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_module">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:text="대기 중…"
                    android:textColor="#00cc88"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>
            </ScrollView>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp">

                <LinearLayout
                    android:id="@+id/romStatusRow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_module"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/tvRomStatus"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="ROM 확인 중…"
                        android:textColor="#aaaacc"
                        android:textSize="10sp"
                        android:fontFamily="monospace"/>

                    <Button
                        android:id="@+id/btnRomHelp"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_gravity="end"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:text="❓ ROM"
                        android:textSize="9sp"
                        android:textColor="#ccccdd"
                        android:background="@drawable/btn_physical_neutral"/>
                </LinearLayout>

                <!-- 사운드폰트 선택 (SoundFont 모드일 때, romStatusRow와 같은 자리를 공유) -->
                <LinearLayout
                    android:id="@+id/layoutSoundFontPicker"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_module"
                    android:padding="6dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvSoundFontName"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="선택된 사운드폰트 없음"
                        android:textColor="#aaaacc"
                        android:textSize="10sp"
                        android:fontFamily="monospace"/>

                    <Button
                        android:id="@+id/btnPickSoundFont"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_gravity="end"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:text="🎵 파일"
                        android:textSize="9sp"
                        android:textColor="#ccccdd"
                        android:background="@drawable/btn_physical_neutral"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <Spinner
            android:id="@+id/spinnerModel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- 오른쪽: LINK (연결 방식) + 실행 버튼 -->
    <LinearLayout
        android:layout_width="132dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_module"
        android:padding="6dp"
        android:layout_marginStart="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LINK"
            android:textColor="#8888aa"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:gravity="center"
            android:paddingBottom="6dp"/>

        <RadioGroup
            android:id="@+id/rgConnection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbConnRtp"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginBottom="5dp"
                android:checked="true"
                android:text="RTP-MIDI"
                android:textSize="11sp"
                android:textColor="#e0e0ff"
                android:button="@null"
                android:drawableStart="@drawable/dot_led_selector"
                android:drawablePadding="6dp"
                android:paddingStart="8dp"
                android:gravity="center_vertical"
                android:background="@drawable/btn_led_toggle_bg"/>

            <RadioButton
                android:id="@+id/rbConnUsb"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginBottom="5dp"
                android:text="USB 시리얼"
                android:textSize="11sp"
                android:textColor="#e0e0ff"
                android:button="@null"
                android:drawableStart="@drawable/dot_led_selector"
                android:drawablePadding="6dp"
                android:paddingStart="8dp"
                android:gravity="center_vertical"
                android:background="@drawable/btn_led_toggle_bg"/>

            <RadioButton
                android:id="@+id/rbConnUsbMidi"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:text="USB MIDI"
                android:textSize="11sp"
                android:textColor="#e0e0ff"
                android:button="@null"
                android:drawableStart="@drawable/dot_led_selector"
                android:drawablePadding="6dp"
                android:paddingStart="8dp"
                android:gravity="center_vertical"
                android:background="@drawable/btn_led_toggle_bg"/>
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnResetEngine"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="🔄 초기화"
            android:textSize="12sp"
            android:textColor="#ffffff"
            android:background="@drawable/btn_physical_reset"
            android:layout_marginBottom="6dp"
            android:enabled="false"/>

        <Button
            android:id="@+id/btnConnectToggle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="▶ 연결 시작"
            android:textSize="12sp"
            android:textColor="#ffffff"
            android:background="@drawable/btn_physical_primary"/>
    </LinearLayout>

    </LinearLayout>

</LinearLayout>
