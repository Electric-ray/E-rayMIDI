<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_rack_panel"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- ================= 타이틀 바 ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="E-rayMIDI v1.5"
            android:textColor="#e0e0ff"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:lineSpacingExtra="1dp"
            android:text="전기가오리\n네이버 도스박물관"
            android:textColor="#77778a"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- ================= 본체 3열 ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 왼쪽: MODE (재생 엔진 선택) -->
        <LinearLayout
            android:layout_width="98dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_module"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.15"
                android:paddingBottom="6dp"
                android:text="MODE"
                android:textColor="#8888aa"
                android:textSize="10sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgEngine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbEngineSc55"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/btn_led_toggle_bg"
                    android:button="@null"
                    android:checked="true"
                    android:drawableStart="@drawable/dot_led_selector"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:text="SC-55"
                    android:textColor="#e0e0ff"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/rbEngineSoundfont"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/btn_led_toggle_bg"
                    android:button="@null"
                    android:drawableStart="@drawable/dot_led_selector"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:text="SoundFont"
                    android:textColor="#e0e0ff"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/rbEngineMunt"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/btn_led_toggle_bg"
                    android:button="@null"
                    android:drawableStart="@drawable/dot_led_selector"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:text="MT-32"
                    android:textColor="#e0e0ff"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/rbEngineGearmulator"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_led_toggle_bg"
                    android:button="@null"
                    android:drawableStart="@drawable/dot_led_selector"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:text="88emu"
                    android:textColor="#e0e0ff"
                    android:textSize="11sp" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 가운데: 화면 + 상태 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 화면 스택: SC-55는 LCD, MT-32/SoundFont/S-YXG50은 LED 패널.
             동시에 하나만 visible이라 FrameLayout으로 겹쳐서 공간을 공유한다. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_lcd_bezel"
                android:padding="5dp">

                <FrameLayout
                    android:id="@+id/lcdFrame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.example.nukedsc55.LcdView
                        android:id="@+id/ivLcd"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/llMuntContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- 실제 mt32emu가 에뮬레이션하는 MT-32/CM-32L LCD 텍스트를
                     SC-55처럼 그래픽 도트매트릭스 LCD 느낌으로 그린다
                     (MuntLcdView 참고 — 작은 비트맵을 최근접 이웃으로 확대). -->
                    <com.example.nukedsc55.MuntLcdView
                        android:id="@+id/muntLcdView"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_marginBottom="6dp" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:id="@+id/llMuntPanel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:id="@+id/llSoundfontPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone" />
                </ScrollView>

                <LinearLayout
                    android:id="@+id/llGearmulatorContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- 88lib가 노출하는 실제 문자 LCD 텍스트(MT-32/CM-32L류 전용 —
                     SC-55/SC-88 등 그래픽 LCD 기종은 API가 텍스트를 안 주므로 빈 화면). -->
                    <com.example.nukedsc55.MuntLcdView
                        android:id="@+id/gearmulatorLcdView"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_marginBottom="6dp" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:id="@+id/llGearmulatorPanel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>
            </FrameLayout>

            <!-- 상태 로그 + ROM 상태: 좌우 배치 (표시 정보량에 비해 세로로 쌓으면 폭이 너무 넓었음) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <ScrollView
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_module">

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:padding="6dp"
                        android:text="대기 중…"
                        android:textColor="#00cc88"
                        android:textSize="11sp" />
                </ScrollView>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/romStatusRow"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_module"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <TextView
                            android:id="@+id/tvRomStatus"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text="ROM 확인 중…"
                            android:textColor="#aaaacc"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btnGearmulatorModel"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_gravity="end"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/btn_physical_neutral"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="10dp"
                            android:paddingTop="0dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="0dp"
                            android:text="🎹 기종: SC-55mk2"
                            android:textColor="#ccccdd"
                            android:textSize="9sp"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/btnRomHelp"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_gravity="end"
                            android:background="@drawable/btn_physical_neutral"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="10dp"
                            android:paddingTop="0dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="0dp"
                            android:text="❓ ROM"
                            android:textColor="#ccccdd"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- 사운드폰트 선택 (SoundFont 모드일 때, romStatusRow와 같은 자리를 공유) -->
                    <LinearLayout
                        android:id="@+id/layoutSoundFontPicker"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_module"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvSoundFontName"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:gravity="center_vertical"
                            android:text="선택된 사운드폰트 없음"
                            android:textColor="#aaaacc"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btnPickSoundFont"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_gravity="end"
                            android:background="@drawable/btn_physical_neutral"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="10dp"
                            android:paddingTop="0dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="0dp"
                            android:text="🎵 파일"
                            android:textColor="#ccccdd"
                            android:textSize="9sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <Spinner
                android:id="@+id/spinnerModel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 오른쪽: LINK (연결 방식) + 실행 버튼 -->
        <LinearLayout
            android:layout_width="132dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_module"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.15"
                android:paddingBottom="6dp"
                android:text="LINK"
                android:textColor="#8888aa"
                android:textSize="10sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgConnection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbConnRtp"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/btn_led_toggle_bg"
                    android:button="@null"
                    android:checked="true"
                    android:drawableStart="@drawable/dot_led_selector"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:text="RTP-MIDI"
                    android:textColor="#e0e0ff"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/rbConnUsb"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/btn_led_toggle_bg"
                    android:button="@null"
                    android:drawableStart="@drawable/dot_led_selector"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:text="USB 시리얼"
                    android:textColor="#e0e0ff"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/rbConnUsbMidi"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:background="@drawable/btn_led_toggle_bg"
                    android:button="@null"
                    android:drawableStart="@drawable/dot_led_selector"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:text="USB MIDI"
                    android:textColor="#e0e0ff"
                    android:textSize="11sp" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnResetEngine"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/btn_physical_reset"
                android:enabled="false"
                android:text="🔄 초기화"
                android:textColor="#ffffff"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnConnectToggle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/btn_physical_primary"
                android:text="▶ 연결 시작"
                android:textColor="#ffffff"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
