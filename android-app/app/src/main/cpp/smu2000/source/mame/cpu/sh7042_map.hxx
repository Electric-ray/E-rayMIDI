void sh7042_device::internal_w32(offs_t a, u32 v)
{
	switch(a) {
	case 0xffff8380: m_porta->dr_w(0, v, 0xffffffff); return;
	case 0xffff8384: m_porta->io_w(0, v, 0xffffffff); return;
	case 0xffff838c: pcf_al_w(0, v, 0xffffffff); return;
	case 0xffff8398: pcf_b_w(0, v, 0xffffffff); return;
	case 0xffff83a0: m_portd->dr_w(0, v, 0xffffffff); return;
	case 0xffff83a4: m_portd->io_w(0, v, 0xffffffff); return;
	case 0xffff83a8: pcf_dh_w(0, v, 0xffffffff); return;
	case 0xffff83b8: pcf_e_w(0, v, 0xffffffff); return;
	case 0xffff86c0: m_dmac0->sar_w(0, v, 0xffffffff); return;
	case 0xffff86c4: m_dmac0->dar_w(0, v, 0xffffffff); return;
	case 0xffff86c8: m_dmac0->dmatcr_w(0, v, 0xffffffff); return;
	case 0xffff86cc: m_dmac0->chcr_w(0, v, 0xffffffff); return;
	case 0xffff86d0: m_dmac1->sar_w(0, v, 0xffffffff); return;
	case 0xffff86d4: m_dmac1->dar_w(0, v, 0xffffffff); return;
	case 0xffff86d8: m_dmac1->dmatcr_w(0, v, 0xffffffff); return;
	case 0xffff86dc: m_dmac1->chcr_w(0, v, 0xffffffff); return;
	case 0xffff86e0: m_dmac2->sar_w(0, v, 0xffffffff); return;
	case 0xffff86e4: m_dmac2->dar_w(0, v, 0xffffffff); return;
	case 0xffff86e8: m_dmac2->dmatcr_w(0, v, 0xffffffff); return;
	case 0xffff86ec: m_dmac2->chcr_w(0, v, 0xffffffff); return;
	case 0xffff86f0: m_dmac3->sar_w(0, v, 0xffffffff); return;
	case 0xffff86f4: m_dmac3->dar_w(0, v, 0xffffffff); return;
	case 0xffff86f8: m_dmac3->dmatcr_w(0, v, 0xffffffff); return;
	case 0xffff86fc: m_dmac3->chcr_w(0, v, 0xffffffff); return;
	}
	// 32bit レジスタでないところは 16bit を 2 回
	internal_w16(a, u16(v >> 16));
	internal_w16(a + 2, u16(v));
}

