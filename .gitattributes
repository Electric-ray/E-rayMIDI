# 텍스트 파일은 기본적으로 각 플랫폼에 맞게 자동 정규화
* text=auto

# 소스 코드는 커밋 시 LF로 통일 (Windows/Android Studio 환경에서 CRLF로 저장돼도
# 저장소에는 LF로 들어가도록 — 여러 환경에서 협업 시 줄바꿈 diff 노이즈 방지)
*.kt   text eol=lf
*.kts  text eol=lf
*.java text eol=lf
*.cpp  text eol=lf
*.h    text eol=lf
*.xml  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.properties text eol=lf

# 바이너리 파일은 diff/변환 대상에서 제외
*.png  binary
*.jpg  binary
*.jpeg binary
*.rom  binary
*.bin  binary
*.sf2  binary
*.apk  binary
*.jar  binary
*.so   binary
